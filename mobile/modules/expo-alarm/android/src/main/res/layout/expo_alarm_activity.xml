<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="#18161D"
  android:padding="32dp">

  <TextView
    android:id="@+id/alarm_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#F7F5F2"
    android:textSize="56sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/alarm_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:gravity="center"
    android:textColor="#F7F5F2"
    android:textSize="22sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/alarm_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:textColor="#A79D8C"
    android:textSize="15sp" />

  <Button
    android:id="@+id/alarm_stop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="48dp"
    android:text="Stop"
    android:textAllCaps="false"
    android:textColor="#18161D"
    android:textSize="17sp"
    android:backgroundTint="#F7F5F2" />

  <Button
    android:id="@+id/alarm_snooze"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="Snooze"
    android:textAllCaps="false"
    android:textColor="#F7F5F2"
    android:textSize="17sp"
    android:backgroundTint="#2A2830" />

</LinearLayout>
