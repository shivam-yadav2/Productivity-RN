<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Firing at an exact moment even in Doze. USE_EXACT_ALARM is granted at install
       time for alarm-clock style apps; SCHEDULE_EXACT_ALARM is the user-grantable
       fallback we check and request at runtime on Android 12/13. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <!-- Showing the alarm screen over the lock screen. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Alarms live in AlarmManager, which the OS clears on reboot, so they have to be
       re-registered once the device finishes booting. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <application>

    <!-- The ringing screen. `showOnLockScreen` + `turnScreenOn` are what let it take
         over a locked device the way a clock app does. singleInstance so a second
         alarm reuses the same task instead of stacking screens. -->
    <activity
      android:name="expo.modules.alarm.AlarmActivity"
      android:exported="false"
      android:launchMode="singleInstance"
      android:showOnLockScreen="true"
      android:turnScreenOn="true"
      android:showWhenLocked="true"
      android:excludeFromRecents="true"
      android:taskAffinity="expo.modules.alarm.ring"
      android:theme="@style/ExpoAlarmTheme" />

    <receiver
      android:name="expo.modules.alarm.AlarmReceiver"
      android:exported="false" />

    <receiver
      android:name="expo.modules.alarm.BootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <service
      android:name="expo.modules.alarm.AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

  </application>
</manifest>
